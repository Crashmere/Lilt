{
  "id": "lilt",
  "name": "Lilt",
  "description": "个人音乐与 MV 收藏库和浏览器播放器，媒体、封面和歌词均由自己上传。",
  "icon": "/lilt/apple-touch-icon.png",
  "url": "/lilt/",
  "repo": "https://github.com/Crashmere/Lilt",
  "root": "/opt/lilt",
  "port": 18089,
  "user": "lilt",
  "units": ["lilt.service", "lilt-lyrics.service"],
  "database": "/opt/lilt/data/lilt.sqlite",
  "resources": [
    {
      "id": "data",
      "name": "业务数据",
      "path": "/opt/lilt/data",
      "purpose": "歌曲、MV、专辑与歌手资料、版本、别名、标签、收藏、歌词、歌单与规则、听歌历史、持久媒体上传与类型、封面归属、文件历史哈希与歌词分析任务；MV 与歌曲独立，视频资料仅写入目录；历史哈希不保留音频编辑副本，媒体均由本人提供。",
      "kind": "data",
      "browse": true,
      "cleanup": false
    },
    {
      "id": "originals",
      "name": "音乐、MV 与封面原件",
      "path": "/opt/lilt/data/originals",
      "purpose": "按 SHA-256 保存音频与 videos 子目录中的不变 MV 原件；歌曲资料、歌词和封面直接写回音频，不重编码音轨、不保留编辑副本；明确替换的历史音频与旧封面归属保留，歌曲和 MV 回收站均保留原件并可恢复。",
      "kind": "media",
      "browse": true,
      "cleanup": false
    },
    {
      "id": "uploads",
      "name": "上传暂存",
      "path": "/opt/lilt/data/uploads",
      "purpose": "已写入并确认偏移的未完成音乐和 MV 分段，供浏览器中断后续传；取消仅清理所选未完成上传，nas 手工全量备份收录持久暂存。",
      "kind": "cache",
      "browse": false,
      "cleanup": false
    },
    {
      "id": "covers",
      "name": "封面派生",
      "path": "/opt/lilt/data/covers",
      "purpose": "音频嵌入封面的安全 JPEG 与 MV 初始帧预览图；歌曲新封面编辑保留嵌入图像和展示派生，不另存上传原图；nas 手工全量备份包含已存派生和写回暂存。",
      "kind": "cache",
      "browse": false,
      "cleanup": false
    },
    {
      "id": "playback",
      "name": "兼容播放文件",
      "path": "/opt/lilt/data/playback",
      "purpose": "按源指纹生成并复用的标准、省流量 AAC/M4A 与 mv 子目录中的兼容 H.264/AAC MP4 和处理引擎记录；不覆盖原音频或视频，nas 手工全量备份收录已存文件。",
      "kind": "cache",
      "browse": false,
      "cleanup": false
    },
    {
      "id": "analysis",
      "name": "歌词分析暂存",
      "path": "/opt/lilt/data/analysis",
      "purpose": "模型校准和波形任务使用当前音频的硬链接快照、推理暂存、工作锁和运行缓存；结束或取消后清理所选任务暂存，重启清理无归属材料；候选在同一 SQLite 内，不自动写回歌曲、不保留歌词编辑版本。",
      "kind": "cache",
      "browse": false,
      "cleanup": false
    },
    {
      "id": "releases",
      "name": "部署版本",
      "path": "/opt/lilt/releases",
      "purpose": "程序、哈希、发布验收和回退记录；清理只限本应用发布材料，保留当前版本及失败保护。",
      "kind": "releases",
      "browse": true,
      "cleanup": true
    },
    {
      "id": "config",
      "name": "运行配置",
      "path": "/opt/lilt/config",
      "purpose": "Lilt systemd、Nginx、私有 Origin 环境、Portal 声明及发布来源；共享网关、认证和隧道由 server-operations 维护。",
      "kind": "config",
      "browse": false,
      "cleanup": false
    },
    {
      "id": "bin",
      "name": "服务程序",
      "path": "/opt/lilt/bin",
      "purpose": "本地构建的服务程序、嵌入网页和固定受限发布入口；FFmpeg 和 libvips 复用 nas 已安装运行工具。",
      "kind": "binaries",
      "browse": false,
      "cleanup": false
    },
    {
      "id": "lyrics-model",
      "name": "歌词模型运行环境",
      "path": "/opt/lilt/bin/lyrics-model",
      "purpose": "独立只读 CPython 环境、固定依赖、SOFA 代码与中英歌声权重和词典；由管理员按校验清单安装，运行时不联网，不复用或改动 Aura、Curio 的图像环境。",
      "kind": "binaries",
      "browse": false,
      "cleanup": false
    },
    {
      "id": "docs",
      "name": "维护文档",
      "path": "/opt/lilt/docs",
      "purpose": "架构、API、原件保留、浏览器状态、上传、部署和恢复契约。",
      "kind": "documents",
      "browse": true,
      "cleanup": false
    }
  ],
  "apis": [
    {"method": "GET", "path": "/healthz", "description": "直连数据库健康状态"},
    {"method": "GET", "path": "/lilt/healthz", "description": "前缀健康状态，公开入口仍需设备授权"},
    {"method": "GET", "path": "/lilt/api/library", "description": "读取歌曲、专辑、歌手、歌单、标签与统计"},
    {"method": "GET", "path": "/lilt/api/mvs", "description": "读取独立 MV 库或回收站"},
    {"method": "GET", "path": "/lilt/api/mvs/{id}", "description": "读取 MV 资料与原件参数"},
    {"method": "PATCH", "path": "/lilt/api/mvs/{id}", "description": "保存 MV 名称、艺术家与收藏，保留原视频字节"},
    {"method": "DELETE", "path": "/lilt/api/mvs/{id}", "description": "将 MV 移入可恢复的回收站"},
    {"method": "POST", "path": "/lilt/api/mvs/{id}/restore", "description": "恢复 MV"},
    {"method": "GET", "path": "/lilt/api/mvs/{id}/cover", "description": "读取 MV 初始帧 JPEG"},
    {"method": "GET", "path": "/lilt/api/mvs/{id}/stream", "description": "读取原视频或已准备的兼容 MP4，支持 Range"},
    {"method": "HEAD", "path": "/lilt/api/mvs/{id}/stream", "description": "读取视频流响应头"},
    {"method": "GET", "path": "/lilt/api/mvs/{id}/download", "description": "下载不变的 MV 原件"},
    {"method": "GET", "path": "/lilt/api/mvs/{id}/playback", "description": "读取兼容视频准备状态与处理引擎"},
    {"method": "POST", "path": "/lilt/api/mvs/{id}/playback", "description": "异步准备或复用兼容 MP4，优先 CUDA/NVENC"},
    {"method": "GET", "path": "/lilt/api/tracks", "description": "按关键词、收藏、标签、专辑、歌手或回收站查询歌曲"},
    {"method": "GET", "path": "/lilt/api/tracks/{id}", "description": "读取歌曲详情与歌词"},
    {"method": "GET", "path": "/lilt/api/tracks/{id}/lyrics", "description": "读取歌词正文与独立内容版本"},
    {"method": "GET", "path": "/lilt/api/lyrics-tools", "description": "查询歌词工作服务、中英歌声模型及语言可用状态"},
    {"method": "GET", "path": "/lilt/api/tracks/{id}/lyrics-jobs", "description": "读取歌曲最近的波形与模型候选任务"},
    {"method": "POST", "path": "/lilt/api/tracks/{id}/lyrics-jobs", "description": "按音频和歌词版本提交离线波形或中英歌声对齐，不自动写回"},
    {"method": "GET", "path": "/lilt/api/lyrics-jobs/{job}", "description": "读取歌词分析进度、候选字词时间或波形"},
    {"method": "DELETE", "path": "/lilt/api/lyrics-jobs/{job}", "description": "取消未完成的歌词分析与所选临时材料"},
    {"method": "PATCH", "path": "/lilt/api/tracks/{id}", "description": "将资料、制作信息、版本、别名、标签、歌词和封面移除写回音频；收藏仅更新资料库"},
    {"method": "DELETE", "path": "/lilt/api/tracks/{id}", "description": "移入可恢复的回收站，保留原件"},
    {"method": "POST", "path": "/lilt/api/tracks/{id}/restore", "description": "恢复已移除歌曲"},
    {"method": "GET", "path": "/lilt/api/tracks/{id}/stream", "description": "读取原音频或独立标准、省流量播放版本，支持 Range"},
    {"method": "HEAD", "path": "/lilt/api/tracks/{id}/stream", "description": "读取音频响应头与实际播放参数"},
    {"method": "GET", "path": "/lilt/api/tracks/{id}/download", "description": "以原文件名下载当前音频，包含已保存的标签、歌词和封面"},
    {"method": "HEAD", "path": "/lilt/api/tracks/{id}/download", "description": "读取原件下载响应头"},
    {"method": "GET", "path": "/lilt/api/tracks/{id}/cover", "description": "读取安全静态封面"},
    {"method": "POST", "path": "/lilt/api/tracks/{id}/cover", "description": "一次提交曲目信息与封面，不设文件大小上限，自动按比例缩小至最长边 1600 像素后写入音频并生成展示 JPEG"},
    {"method": "GET", "path": "/lilt/api/albums/{id}", "description": "按碟号和曲目序号读取专辑歌曲"},
    {"method": "GET", "path": "/lilt/api/artists/{id}", "description": "读取歌手与关联歌曲、专辑"},
    {"method": "GET", "path": "/lilt/api/export", "description": "导出曲库元数据、歌单与听歌历史 JSON，不是备份恢复入口"},
    {"method": "GET", "path": "/lilt/api/uploads", "description": "读取可继续的持久上传与服务端偏移"},
    {"method": "POST", "path": "/lilt/api/uploads", "description": "准备音频上传，按当前与编辑前的文件哈希识别已有歌曲及可恢复会话；明确替换使用所选音频"},
    {"method": "PATCH", "path": "/lilt/api/uploads/{id}", "description": "写入最多 32 MiB 原始分段，持久落盘后确认偏移"},
    {"method": "POST", "path": "/lilt/api/uploads/{id}/complete", "description": "校验完整 SHA-256 并入库，或明确替换已有逻辑歌曲"},
    {"method": "DELETE", "path": "/lilt/api/uploads/{id}", "description": "取消所选未完成上传及其暂存，不删除已入库原件"},
    {"method": "POST", "path": "/lilt/api/playlists", "description": "创建手动或规则歌单"},
    {"method": "GET", "path": "/lilt/api/playlists/{id}", "description": "读取歌单与实际歌曲"},
    {"method": "PUT", "path": "/lilt/api/playlists/{id}", "description": "更新名称、说明、规则与手动歌曲排序"},
    {"method": "DELETE", "path": "/lilt/api/playlists/{id}", "description": "移除歌单，保留歌曲"},
    {"method": "GET", "path": "/lilt/api/playlists/{id}/export", "description": "导出使用原始文件名的 M3U 歌单"},
    {"method": "GET", "path": "/lilt/api/history", "description": "读取最近听歌会话"},
    {"method": "POST", "path": "/lilt/api/history", "description": "按会话幂等记录累计实际听歌秒数与完成状态"}
  ]
}
